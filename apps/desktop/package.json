{
  "name": "@omnicrawl/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local-first OmniCrawl desktop runtime with embedded browser actors.",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev": "pnpm build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5174 && cross-env OMNICRAWL_DESKTOP_DEV_URL=http://127.0.0.1:5174 electron .\"",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  }
}
