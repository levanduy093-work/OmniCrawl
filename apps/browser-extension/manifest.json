{
  "manifest_version": 3,
  "name": "OmniCrawl Browser Agent",
  "version": "0.4.1",
  "description": "Runs OmniCrawl jobs inside your authenticated browser without exporting cookies.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:5173/*",
    "https://shopee.vn/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["shopee-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["shopee-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
