{
  "name": "template-ts",
  "version": "1.0.0",
  "description": "Standard TypeScript actor template for OmniCrawl browser and API scrapers.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "title": "Search Keyword",
        "description": "Keyword or query to search on target platform",
        "default": "máy in 3d"
      },
      "startUrl": {
        "type": "string",
        "title": "Start URL",
        "description": "Direct URL to scrape if keyword is not provided",
        "default": ""
      },
      "maxItems": {
        "type": "integer",
        "title": "Max Items",
        "description": "Maximum number of items/products to extract",
        "default": 30,
        "minimum": 1,
        "maximum": 500
      },
      "cookie": {
        "type": "string",
        "title": "Session Cookie",
        "description": "Authentication cookie header string (optional)",
        "default": ""
      },
      "proxyUrl": {
        "type": "string",
        "title": "Proxy URL",
        "description": "HTTP/HTTPS proxy server URL",
        "default": ""
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "itemId",
      "title",
      "price",
      "url",
      "crawledAt"
    ],
    "properties": {
      "itemId": {
        "type": "string",
        "description": "Unique identifier of the item"
      },
      "title": {
        "type": "string",
        "description": "Title or product name"
      },
      "price": {
        "type": "number",
        "description": "Price in local currency"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "description": "Item web URL"
      },
      "imageUrl": {
        "type": "string",
        "format": "uri",
        "description": "Main image preview URL"
      },
      "rating": {
        "type": "number",
        "description": "Average rating star score"
      },
      "crawledAt": {
        "type": "string",
        "format": "date-time",
        "description": "Timestamp when extracted"
      }
    }
  }
}
