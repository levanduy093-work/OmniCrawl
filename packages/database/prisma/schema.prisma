generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("USER") // USER or ADMIN
  status    String   @default("ACTIVE") // ACTIVE or SUSPENDED
  tier      String   @default("FREE") // FREE, BASIC, PRO, ENTERPRISE
  credits   Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actors    Actor[]
  runs      Run[]

  @@index([role, status])
}

model Actor {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  version     String     @default("1.0.0")
  inputSchema String?    // JSON schema cho input
  outputSchema String?   // JSON schema cho each item in output.items
  userId      String?    // Bổ sung userId (Optional for backward compatibility during dev)
  user        User?      @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  runs        Run[]
}

model Run {
  id             String    @id @default(cuid())
  actorId        String
  userId         String?
  actor          Actor     @relation(fields: [actorId], references: [id])
  user           User?     @relation(fields: [userId], references: [id])
  status         String    @default("PENDING") // CREATING, PENDING, BROWSER_PENDING, RUNNING, BROWSER_RUNNING, STOPPING, STOPPED, SUCCESS, PARTIAL, FAILED
  input          Json?
  outputMetadata Json?
  outputError    String?
  itemCount      Int       @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  items          DatasetItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DatasetItem {
  id          String   @id @default(cuid())
  runId       String
  position    Int
  externalKey String?
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@unique([runId, externalKey])
  @@index([runId, position])
}

model ProxyGroup {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proxies   Proxy[]
}

model Proxy {
  id            String      @id @default(cuid())
  groupId       String
  protocol      String      @default("http") // http, https, socks5
  host          String
  port          Int
  username      String?
  password      String?
  country       String?
  isRotating    Boolean     @default(false) // true = rotating gateway
  enabled       Boolean     @default(true)
  status        String      @default("UNKNOWN") // UNKNOWN, ALIVE, DEAD, SLOW
  lastCheckedAt DateTime?
  lastLatencyMs Int?
  failCount     Int         @default(0)
  successCount  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  group         ProxyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([host, port, username])
  @@index([groupId, enabled, status])
}
